# ========================================
# EMAIL CONFIGURATION
# ========================================

# Option 1: Resend API (requires backend or serverless)
# Get your API key at: https://resend.com/api-keys
VITE_RESEND_API_KEY=re_123456789
VITE_FROM_EMAIL=noreply@nikkeybox-store.com

# Option 2: EmailJS (works in frontend, easier setup!)
# Get credentials at: https://www.emailjs.com/
# See EMAILJS_SETUP.md for detailed instructions
VITE_EMAILJS_SERVICE_ID=service_abc123
VITE_EMAILJS_TEMPLATE_ID=template_xyz789
VITE_EMAILJS_PUBLIC_KEY=your_public_key

# /api/send-email envia pelo Google Workspace (SMTP smtp.gmail.com:465) usando a
# conta noreply@nikkeybox-store.com. Gere uma "App password" no painel da
# conta Google (exige 2FA ativado) e cole aqui — é a ÚNICA credencial de SMTP que
# o endpoint lê (nome esperado: NOREPLY_EMAIL_PASSWORD; fallback: GMAIL_APP_PASSWORD).
NOREPLY_EMAIL_PASSWORD=your_google_workspace_app_password

# Firebase Admin for generating official email verification links in /api/send-email.
# Use either FIREBASE_SERVICE_ACCOUNT_JSON or the three split variables below.
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"firebase-adminsdk-...@....iam.gserviceaccount.com"}
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-...@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ========================================
# WHATSAPP CONFIGURATION
# ========================================

# Option 1: Twilio API (automatic sending)
# Get credentials at: https://console.twilio.com
VITE_TWILIO_ACCOUNT_SID=AC1234567890abcdef
VITE_TWILIO_AUTH_TOKEN=your_auth_token
VITE_TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Option 2: Simple WhatsApp (always works, opens WhatsApp Web/App)
# No configuration needed! Falls back automatically.

# ========================================
# STORE INFORMATION
# ========================================

# Store Contact
VITE_STORE_PHONE=070-1367-1679
VITE_STORE_EMAIL=contato@nikkeybox-store.com

# Social links (usados na página de Vlog)
VITE_YOUTUBE_URL=https://www.youtube.com/@seucanal
VITE_INSTAGRAM_URL=https://www.instagram.com/seuperfil

# ========================================
# ADMIN CREDENTIALS (OBRIGATÓRIO em produção)
# ========================================
# Firebase Web API Key — necessária para o endpoint /api/admin-session validar a
# senha de SUB-ADMINS via Identity Toolkit (o super-admin autentica direto do
# client, sem depender desta variável). Encontre em:
# Firebase Console → Configurações do projeto → Geral → Seus aplicativos da Web.
FIREBASE_WEB_API_KEY=sua_firebase_web_api_key

# E-mail do super-admin (mesma conta do Firebase Auth).
VITE_ADMIN_EMAIL=dracko2007@gmail.com
CRON_SECRET=sua_chave_secreta_do_cron

# ========================================
# ANALYTICS DE CONVERSÃO (GA4 + Meta Pixel)
# ========================================
# GA4: NÃO precisa de variável aqui — já usa o measurementId fixo em
# src/config/firebase.ts (Firebase Analytics). Só dispara após o visitante
# aceitar cookies no CookieBanner (ver src/lib/analytics.ts).
#
# Meta Pixel: opcional. Sem esta variável, o pixel simplesmente não carrega
# (nenhum erro, nenhuma chamada de rede). Encontre o ID em
# Meta Events Manager → Fontes de dados → seu Pixel → Configurações.
VITE_META_PIXEL_ID=1234567890123456

# ========================================
# AI / PRODUCT ENRICHMENT (serverless)
# ========================================
# Groq API — KimiClaw + Auto-preencher produto.
# Cadastre grátis em https://console.groq.com → API Keys
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxx

# Rakuten Ichiba API — busca preço e fotos reais de produtos japoneses.
# Cadastre grátis em https://webservice.rakuten.co.jp → Criar aplicação
# Sem esta chave o Auto-preencher usa só a IA (preço estimado, sem fotos reais).
RAKUTEN_APP_ID=1234567890123456789

# ========================================
# STRIPE — pagamento com cartão (checkout internacional)
# ========================================
# Chave pública (frontend) — Dashboard Stripe → Developers → API keys
VITE_STRIPE_PUBLISHABLE_KEY=replace_with_your_stripe_publishable_key
# Chave secreta (server-side apenas, usada em /api/create-payment-intent)
STRIPE_SECRET_KEY=replace_with_your_stripe_secret_key

# ========================================
# WEB PUSH (VAPID) — notificações push via app/PWA
# ========================================
# Gere seu próprio par com: npx web-push generate-vapid-keys
# A pública é exposta no frontend; a privada fica só no servidor (/api/send-push).
VITE_VAPID_PUBLIC_KEY=BXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
VAPID_PUBLIC_KEY=BXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
VAPID_PRIVATE_KEY=your_vapid_private_key
VAPID_SUBJECT=mailto:contato@seudominio.com
