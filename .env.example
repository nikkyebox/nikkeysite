# ============================================
# RESEND EMAIL SERVICE
# ============================================

# Resend API Key for sending emails
# Get it from: https://resend.com/api-keys
RESEND_API_KEY=re_your_api_key_here

# Email sender configuration
RESEND_FROM_EMAIL=contato@nikkeybox.jp
RESEND_FROM_NAME=NikkeyBox Store
RESEND_REPLY_TO=contato@nikkeybox.jp

# Webhook secret for Resend events
# Get it from: https://resend.com/webhooks
RESEND_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# ============================================
# VERCEL / DEPLOYMENT
# ============================================

# Node environment
NODE_ENV=development

# Site URL for production
VITE_PUBLIC_SITE_URL=http://localhost:5173

# ============================================
# FIREBASE CONFIGURATION
# ============================================

# Firebase API Key (from Firebase Console > Project Settings)
VITE_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key_here

# Firebase Auth Domain
VITE_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com

# Firebase Project ID
VITE_PUBLIC_FIREBASE_PROJECT_ID=your_project_id

# Firebase Storage Bucket
VITE_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.appspot.com

# Firebase Messaging Sender ID
VITE_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id

# Firebase App ID
VITE_PUBLIC_FIREBASE_APP_ID=your_app_id

# Firebase Database URL (if using Realtime Database)
VITE_PUBLIC_FIREBASE_DATABASE_URL=https://your_project.firebaseio.com

# ============================================
# STRIPE PAYMENT INTEGRATION
# ============================================

# Stripe Public Key (visible in frontend)
VITE_PUBLIC_STRIPE_PUBLIC_KEY=pk_test_your_stripe_public_key

# Stripe Secret Key (server-side only)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key

# Stripe Webhook Secret
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret

# ============================================
# GOOGLE SERVICES
# ============================================

# Google OAuth Client ID
VITE_PUBLIC_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# Google OAuth Client Secret (server-side only)
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Google Analytics Measurement ID
VITE_PUBLIC_GOOGLE_ANALYTICS_ID=G_your_measurement_id

# ============================================
# FACEBOOK / SOCIAL
# ============================================

# Facebook App ID for Facebook SDK
VITE_PUBLIC_FACEBOOK_APP_ID=your_facebook_app_id

# Facebook Pixel ID for conversion tracking
VITE_PUBLIC_FACEBOOK_PIXEL_ID=your_facebook_pixel_id

# ============================================
# APPLICATION SETTINGS
# ============================================

# Application name
APP_NAME=NikkeyBox

# Application environment (development, staging, production)
APP_ENV=development

# Debug mode
APP_DEBUG=true

# Timezone
TIMEZONE=Asia/Tokyo

# Language
LANGUAGE=pt-BR

# Currency
CURRENCY=JPY

# ============================================
# FEATURE FLAGS
# ============================================

# Enable/disable features for A/B testing or gradual rollout
VITE_PUBLIC_ENABLE_ANALYTICS=true
VITE_PUBLIC_ENABLE_NOTIFICATIONS=true
VITE_PUBLIC_ENABLE_CHAT=false
VITE_PUBLIC_MAINTENANCE_MODE=false

# ============================================
# EXTERNAL SERVICES
# ============================================

# WhatsApp Business API (if applicable)
WHATSAPP_BUSINESS_ACCOUNT_ID=your_whatsapp_account_id
WHATSAPP_BUSINESS_PHONE_ID=your_whatsapp_phone_id
WHATSAPP_BUSINESS_ACCESS_TOKEN=your_whatsapp_access_token

# SendGrid API Key (if using instead of Resend)
SENDGRID_API_KEY=SG.your_sendgrid_key

# Slack Webhook for notifications
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/your_webhook_url

# AWS S3 Credentials (if storing files)
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_REGION=us-east-1
AWS_S3_BUCKET=your_bucket_name

# ============================================
# DEVELOPMENT / TESTING
# ============================================

# Test email recipient for development
TEST_EMAIL=dev@example.com

# API Rate Limiting
API_RATE_LIMIT_ENABLED=true
API_RATE_LIMIT_MAX_REQUESTS=100
API_RATE_LIMIT_WINDOW_MS=60000

# Log Level (debug, info, warn, error)
LOG_LEVEL=info

# ============================================
# NOTES & INSTRUCTIONS
# ============================================
# 
# 1. Copy this file to .env.local and fill in your actual values
# 2. NEVER commit .env.local to git - it contains secrets!
# 3. Add this to .gitignore: .env.local
# 4. Variables prefixed with VITE_PUBLIC_ are exposed to the frontend
# 5. Server-side secrets (like API keys) should NOT have VITE_PUBLIC_ prefix
# 6. For Vercel deployment, add these variables in Project Settings > Environment Variables
# 7. Keep this file updated when adding new configuration
# 8. For more info, see: RESEND_SETUP.md
#
