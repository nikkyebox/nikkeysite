rules_version = '2';

// Regras do Firebase Storage.
// Os clientes da loja NÃO têm sessão Firebase Auth (só o admin autentica),
// então a escrita nas pastas de mídia de avaliação é liberada, mas com limites
// rígidos de tamanho e tipo para evitar abuso. Leitura é pública (mostrar mídia).
service firebase.storage {
  match /b/{bucket}/o {

    // Vídeos de avaliação: até 60MB, só content-type de vídeo.
    match /review-videos/{productId}/{fileName} {
      allow read: if true;
      allow write: if request.resource.size < 60 * 1024 * 1024
                   && request.resource.contentType.matches('video/.*');
    }

    // Mídia de produto (fonte única desde que o Cloudinary saiu). Só admin
    // escreve — mesma definição de admin do firestore.rules.
    function isAdmin() {
      return request.auth != null && (
        request.auth.token.get('admin', false) == true
        || request.auth.token.get('role', '') == 'admin'
        || request.auth.token.get('adminRole', '') == 'admin'
        || request.auth.token.get('adminRole', 0) in [1, 2, 3]
        || (request.auth.token.get('email_verified', false) == true
            && request.auth.token.get('email', '') == 'dracko2007@gmail.com')
        || firestore.get(/databases/(default)/documents/admins/$(request.auth.uid)).data.get('active', false) == true
      );
    }

    match /products/{productId}/{fileName} {
      allow read: if true;
      allow delete: if isAdmin();
      allow create, update: if isAdmin() && (
        (request.resource.size < 10 * 1024 * 1024 && request.resource.contentType.matches('image/.*'))
        || (request.resource.size < 50 * 1024 * 1024 && request.resource.contentType.matches('video/.*'))
      );
    }

    // Fotos de avaliação: até 8MB, só imagem.
    match /review-photos/{productId}/{fileName} {
      allow read: if true;
      allow write: if request.resource.size < 8 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // Qualquer outro caminho: bloqueado.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
